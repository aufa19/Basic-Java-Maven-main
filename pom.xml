<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd ">

  <!-- Versi POM -->
  <modelVersion>4.0.0</modelVersion>

  <!-- Informasi Proyek -->
  <groupId>contohprojectmaven</groupId>
  <artifactId>contohproject</artifactId>
  <version>0.3.5</version>

  <!-- Informasi Dasar Tambahan (Opsional tapi bagus untuk dokumentasi) -->
  <name>Contoh Project Maven</name>
  <description>Proyek sederhana untuk analisis kode dengan SonarQube/Codacy</description>
  <url>https://github.com/aufa19/Basic-Java-Maven-main </url>

  <!-- Dependencies -->
  <dependencies>
    <!-- JUnit 4 untuk unit testing -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.11</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Properties Global -->
  <properties>
    <!-- Versi Java -->
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>

    <!-- Encoding default -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Versi plugin penting -->
    <maven.compiler.version>3.8.1</maven.compiler.version>
    <surefire.version>3.0.0-M7</surefire.version>
    <jacoco.version>0.8.11</jacoco.version>
    <sonar.version>3.9.1.2184</sonar.version>
  </properties>

  <!-- Build Plugins -->
  <build>
    <plugins>

      <!-- Plugin Compiler -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.version}</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
        </configuration>
      </plugin>

      <!-- Plugin Surefire (untuk eksekusi test JUnit) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <!-- Plugin SonarQube (penting untuk scan ke SonarCloud) -->
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>${sonar.version}</version>
      </plugin>

      <!-- Plugin JaCoCo (untuk code coverage report) -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>generate-execution-data</id>
            <phase>test</phase>
            <goals>
              <goal>dump-output</goal>
            </goals>
          </execution>
          <execution>
            <id>generate-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <!-- Reporting (opsional, untuk laporan lokal) -->
  <reporting>
    <outputDirectory>${project.build.directory}/site</outputDirectory>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
      </plugin>
    </plugins>
  </reporting>

</project>